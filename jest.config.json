{
  "verbose": true,
  "clearMocks": true,
  "collectCoverage": true,
  "testMatch": ["<rootDir>/test/_unit/**/*.spec.js"],
  "collectCoverageFrom": [
    "**/*.js",
    "!**/node_modules/**",
    "!**/coverage/**",
    "!bin/**/*.js",
    "!assets/js/index.js",
    "!config.js",
    "!**/public/js/*.js",
    "!apps/**/fields/*.js",
    "!apps/**/index.js",
    "!apps/**/sections/summary-data-sections.js",
    "!test/**/*.js",
    "!server.js"
  ],
  "coverageReporters": ["text", "lcov", "clover"],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "setupFiles": ["<rootDir>/jest.env.js"]
}
